# glance settings. Copy to .env (git ignores it) and uncomment what you need.
# A variable already set in the environment wins over this file; this file wins over the built-in default.
# Use single quotes around regular expressions so that backslashes stay as written.
# A value ends at its second quote, so write ' inside a regular expression as \x27.
# An unquoted value ends at #; quote a value that contains #.

# Port on 127.0.0.1 (default 7357).
# GLANCE_PORT=7357

# Where Claude Code keeps sessions and transcripts (default ~/.claude).
# CLAUDE_CONFIG_DIR=/path/to/.claude

# --- "needs you" detection ---
# Session names whose own waits are not asks to you (comma-separated; default none).
# GLANCE_IGNORE_NAMES=deploy,review
# Extra sentences that count as an ask to you, added to the built-in ones (case-insensitive regex; default none).
# GLANCE_ASK_EXTRA='\bfor (?:the )?lead\b|\bthe lead[\x27’]?s (?:answer|decision|approval)'

# --- memory sidebar (lines of ~/.claude/projects/*/memory/MEMORY.md that wait on you) ---
# Off by default; 1/on/true/yes turns it on.
# GLANCE_MEMORY=1
# Which index lines to look at (case-insensitive regex; the default is shown).
# GLANCE_MEMORY_CUE='(pending|waiting (?:on|for) you|needs you|blocked on you|decisions? (?:pending|untaken))'
# The part of such a line shown as the wait; no match = line skipped (the default is shown).
# GLANCE_MEMORY_WAIT='((?:\d+ )?decisions? (?:pending|untaken)[^;]*|waiting (?:on|for) you[^;]*|needs you[^;]*|blocked on you[^;]*|pending[^;]*)'
# Index entries whose title matches are skipped.
# GLANCE_MEMORY_SKIP='\b(?:DONE|CLOSED|COMPLETE|PARKED)\b'
# Folder prefixes removed from a memory item's project label after your home folder (comma-separated).
# GLANCE_PROJECT_PREFIX=code-

# --- another screen through Tailscale Serve (see README; never Funnel) ---
# GLANCE_ALLOWED_HOSTS=<machine>.<tailnet>.ts.net:7357
# GLANCE_TAILSCALE_USERS=<your Tailscale login>

# Re-read index.html on every page load (development).
# GLANCE_DEV=1
